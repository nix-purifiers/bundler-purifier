#!/usr/bin/env ruby
# SPDX-License-Identifier: MIT
load ENV.fetch("BUNDLER_PURIFIER_COMMAND", File.join(__dir__, "bundler-purifier"))

bp = BundlerPurifier
working_directory = Dir.pwd
ENV["BUNDLER_PURIFIER_LOCKFILE"] = File.expand_path(ENV["BUNDLER_PURIFIER_LOCKFILE"]) if ENV["BUNDLER_PURIFIER_LOCKFILE"]
ENV["BUNDLER_PURIFIER_TOOL_LOCKFILE"] = File.expand_path(ENV["BUNDLER_PURIFIER_TOOL_LOCKFILE"]) if ENV["BUNDLER_PURIFIER_TOOL_LOCKFILE"]
search = Dir.pwd
until File.file?(File.join(search, "Gemfile")) || File.dirname(search) == search
  search = File.dirname(search)
end
Dir.chdir(search) if File.file?(File.join(search, "Gemfile"))
lock_path = ENV["BUNDLER_PURIFIER_LOCKFILE"] || File.join(Dir.pwd, bp::LOCK_FILE)
unless File.file?("Gemfile") && File.file?(lock_path)
  Dir.chdir(working_directory)
  warn "bundler-purifier: no lockfile; using ordinary, impure Bundler resolution"
  own = ENV["BUNDLER_PURIFIER_BUNDLE"]
  candidate = ENV.fetch("PATH", "").split(File::PATH_SEPARATOR).map { |dir| File.join(dir,"bundle") }.find do |path|
    File.file?(path) && File.executable?(path) && (!own || File.realpath(path) != File.realpath(own)) &&
      !File.realpath(path).match?(%r{/[^/]+-bundler-purifier-[^/]+/bin/bundle\z})
  end
  exec(candidate, *ARGV) if candidate
  exec({"PATH" => "#{RbConfig::CONFIG['bindir']}:#{ENV['PATH']}"}, Gem.ruby, Gem.bin_path("bundler", "bundle"), *ARGV)
end

# Setup must not become part of the wrapped command's stdout.
output = STDOUT.dup
begin
  STDOUT.reopen(STDERR)
  lock = bp.read_lock!
  ready = File.join(bp.state_dir, "bundle-ready")
  unless File.directory?(File.join(bp.state_dir, "bundler")) && File.file?(ready) && File.file?(File.join(bp.state_dir, "environment.json")) && File.read(ready) == lock.fetch("contentHash")
    bp.prefetch([])
    File.write(ready, lock.fetch("contentHash"))
  end
ensure
  STDOUT.reopen(output)
  output.close
end

mutates = %w[add remove update lock].include?(ARGV.first)
environment = JSON.parse(File.read(File.join(bp.state_dir, "environment.json")))
bundler_home = File.join(bp.state_dir, "bundler")
bundler_version = bp.locked_bundler_version(lock)
native_env = { "GEM_HOME" => bundler_home, "GEM_PATH" => bundler_home,
               "BUNDLER_PURIFIER_BUNDLER_VERSION" => bundler_version,
               "PATH" => "#{environment.fetch('PATH')}:#{ENV['PATH']}",
               "LD_LIBRARY_PATH" => [environment.fetch("LD_LIBRARY_PATH"), ENV["LD_LIBRARY_PATH"]].compact.reject(&:empty?).join(File::PATH_SEPARATOR),
               "BUNDLER_PURIFIER_WORKING_DIRECTORY" => working_directory }
bp.with_gemfile_lock_in_tree do
  bp.native_bundle!(native_env, *ARGV, persist_lock: mutates)
end
if mutates
  output = STDOUT.dup
  begin
    STDOUT.reopen(STDERR)
    bp.lock(force: true)
  ensure
    STDOUT.reopen(output)
    output.close
  end
end
