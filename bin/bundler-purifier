#!/usr/bin/env ruby
# SPDX-License-Identifier: MIT
#
# bundler-purifier: the commands of the nix-purifiers contract for Bundler.
#
#   bundler-purifier lock [--force]   record what Gemfile.lock cannot, when
#                                     the Gemfile, Gemfile.lock or a gemspec
#                                     changed (or always, with --force);
#                                     Gemfile.lock keeps its resolution
#   bundler-purifier update [GEM...]  re-resolve every gem, or the named
#                                     ones, with bundle update, then lock
#   bundler-purifier prefetch [ARGS]  realize the locked gems and the dev
#                                     shell, with GC roots, and install the
#                                     bundle from them offline
#   bundler-purifier shell [COMMAND...] enter the project environment, or
#                                     run a command in it
#   bundler-purifier publish [ARGS]   push the gems that Nix built
#
# The commands run in the project root, where the Gemfile is. The purifier
# lockfile lies beside Gemfile.lock, or where `--lockfile <path>` or
# BUNDLER_PURIFIER_LOCKFILE says, for a project whose build is kept
# outside it. Such a build may keep its own Gemfile.lock too, where
# `--tool-lockfile <path>` or BUNDLER_PURIFIER_TOOL_LOCKFILE says: `lock`
# and `update` then write Gemfile.lock there and put the tree's copy back,
# and the checks and Nix builds read it. The package that installs this script sets
# BUNDLER_PURIFIER_LIB (its Nix library), BUNDLER_PURIFIER_SHARED_FLAKE
# (the shared nix-purifiers library) and BUNDLER_PURIFIER_NIXPKGS (the
# nixpkgs it builds with).

# This parser runs on the packaged helper Ruby. A consumer lock or GEM_PATH
# must not activate its legacy Bundler inside this separate host process.
require "rubygems"
helper_bundler = Dir.glob(File.join(Gem.default_specifications_dir, "bundler-*.gemspec"))
  .filter_map { |path| Gem::Specification.load(path) }.max_by(&:version)
unless helper_bundler
  helper_bundler = Gem::Specification.find_all_by_name("bundler")
    .select { |spec| spec.full_gem_path.start_with?(Gem.default_dir + "/") }.max_by(&:version)
end
raise Gem::LoadError, "bundler-purifier: the helper Ruby must supply Bundler" unless helper_bundler
gem "bundler", "= #{helper_bundler.version}"
require "bundler"
require "digest"
require "fileutils"
require "json"
require "open3"
require "rubygems/package"
require "rubygems/remote_fetcher"
require "uri"
require "tmpdir"
require "pathname"
require "yaml"

module BundlerPurifier
  LOCK_FILE = "bundler-purifier.lock.json"
  LOCK_VERSION = 3

  module_function

  def fail!(message)
    warn "bundler-purifier: #{message}"
    exit 1
  end

  def run!(env, *cmd, chdir:)
    ok = system(env, *cmd, chdir: chdir)
    fail!("could not run #{cmd.first}; it is not on PATH") if ok.nil?
    fail!("#{cmd.join(" ")} failed") unless ok
  end

  def capture!(*cmd)
    out, status = Open3.capture2(*cmd)
    fail!("#{cmd.join(" ")} failed") unless status.success?
    out
  end

  def sri(path)
    "sha256-#{Digest::SHA256.file(path).base64digest}"
  end

  def root
    @root ||= begin
      fail!("no Gemfile in #{Dir.pwd}; run bundler-purifier in the project root") unless File.file?("Gemfile")
      Dir.pwd
    end
  end

  # The purifier lockfile: `--lockfile`, then BUNDLER_PURIFIER_LOCKFILE,
  # then bundler-purifier.lock.json beside Gemfile.lock.
  def lockfile_path
    @lockfile_path ||= File.expand_path(@lockfile_option || ENV["BUNDLER_PURIFIER_LOCKFILE"] || File.join(root, LOCK_FILE))
  end

  # The Gemfile.lock in the project tree, the one Bundler reads.
  def tree_gemfile_lock
    File.join(root, "Gemfile.lock")
  end

  # The Gemfile.lock the commands read and write: `--tool-lockfile`, then
  # BUNDLER_PURIFIER_TOOL_LOCKFILE, then the one in the tree. While
  # with_gemfile_lock_in_tree runs Bundler, it is the one in the tree.
  def gemfile_lock_path
    return tree_gemfile_lock if @gemfile_lock_in_tree
    @gemfile_lock_path ||= File.expand_path(@tool_lockfile_option || ENV["BUNDLER_PURIFIER_TOOL_LOCKFILE"] || tree_gemfile_lock)
  end

  # Runs the block with the outside Gemfile.lock in the tree, since Bundler
  # reads and writes only the Gemfile.lock beside the Gemfile. The block
  # starts from the outside copy, or from the tree's copy when the outside
  # one does not exist yet. When the block succeeds, its Gemfile.lock goes
  # to the outside path. The tree's own copy is put back in any case.
  def with_gemfile_lock_in_tree
    outside = gemfile_lock_path
    return yield if @gemfile_lock_in_tree || outside == tree_gemfile_lock

    original = File.file?(tree_gemfile_lock) ? File.binread(tree_gemfile_lock) : nil
    start = File.file?(outside) ? File.binread(outside) : original
    begin
      if start
        File.binwrite(tree_gemfile_lock, start)
      else
        FileUtils.rm_f(tree_gemfile_lock)
      end
      @gemfile_lock_in_tree = true
      result = yield
      if File.file?(tree_gemfile_lock)
        FileUtils.mkdir_p(File.dirname(outside))
        File.binwrite(outside, File.binread(tree_gemfile_lock))
      end
      result
    ensure
      @gemfile_lock_in_tree = false
      if original
        File.binwrite(tree_gemfile_lock, original)
      else
        FileUtils.rm_f(tree_gemfile_lock)
      end
    end
  end

  # Where prefetch keeps its GC roots and the gem cache: beside the
  # purifier lockfile.
  def state_dir
    File.join(File.dirname(lockfile_path), ".bundler-purifier")
  end

  def lock_name
    File.basename(lockfile_path)
  end

  # The path sources of a Gemfile.lock outside the project root, as the
  # lockfile writes them (relative to the root). Bundler's git source is a
  # kind of path source, which this leaves out.
  def external_paths(parser)
    paths = parser.sources.grep(Bundler::Source::Path).reject { |s| s.is_a?(Bundler::Source::Git) }
    paths.map { |s| s.path.to_s }.uniq.reject do |p|
      dir = File.expand_path(p, root)
      dir == root || dir.start_with?("#{root}/")
    end.sort
  end

  # The files whose content decides what the lock holds: the Gemfile, its
  # lockfile, and the gemspecs of the project (outside hidden directories
  # and vendor/) and of its path sources outside the project. A lockfile
  # made from the same definition stays current. buildBundlerProject
  # computes the same hash when it evaluates, to tell a stale lock: each
  # file contributes its name, its length in bytes and its content, each
  # followed by a newline, in the byte order of the names. Gemfile.lock
  # keeps its name when it lies outside the tree.
  def definition_hash
    files = ["Gemfile", "Gemfile.lock"] + Dir.glob("**/*.gemspec", base: root).reject { |f| f.start_with?("vendor/") }
    lockfile = gemfile_lock_path
    if File.file?(lockfile)
      external_paths(Bundler::LockfileParser.new(File.read(lockfile))).each do |p|
        files += Dir.glob("*.gemspec", base: File.expand_path(p, root)).map { |g| File.join(p, g) }
      end
    end
    digest = Digest::SHA256.new
    files.uniq.sort.each do |f|
      path = f == "Gemfile.lock" ? lockfile : File.expand_path(f, root)
      next unless File.file?(path)
      content = File.binread(path)
      digest << "#{f}\n#{content.bytesize}\n" << content << "\n"
    end
    "sha256-#{digest.base64digest}"
  end

  # The hash of a lockfile's content: SHA-256 of its JSON without
  # contentHash, with the keys of every object sorted and no whitespace,
  # which is how Nix's builtins.toJSON writes it. Nix checks it when it
  # reads the lock, to tell a lockfile that was edited by hand.
  def content_hash(lock)
    canonical = ->(value) do
      case value
      when Hash then value.keys.sort.to_h { |k| [k, canonical.(value[k])] }
      when Array then value.map(&canonical)
      else value
      end
    end
    "sha256-#{Digest::SHA256.base64digest(JSON.generate(canonical.(lock.except("contentHash"))))}"
  end

  # The SHA-256 that the CHECKSUMS section of a Gemfile.lock gives each
  # gem, in hex, by "name (version[-platform])".
  def gemfile_lock_checksums(text)
    section = text[/^CHECKSUMS\n(.*?)(?:\n\n|\z)/m, 1] || ""
    section.lines.filter_map do |line|
      m = line.match(/\A  (\S+ \([^)]+\)) sha256=([0-9a-f]+)/)
      [m[1], m[2]] if m
    end.to_h
  end

  def hex_to_sri(hex)
    "sha256-#{[[hex].pack("H*")].pack("m0")}"
  end

  # The Ruby version the project asks for: its .ruby-version, or the RUBY
  # VERSION section of Gemfile.lock.
  def project_ruby_version(lockfile_text = nil)
    dot = File.join(root, ".ruby-version")
    if File.file?(dot)
      version = File.read(dot).strip.delete_prefix("ruby-")
      return version unless version.empty?
    end
    lockfile_text ||= File.file?(gemfile_lock_path) ? File.read(gemfile_lock_path) : ""
    lockfile_text[/^RUBY VERSION\n\s+ruby (\d+\.\d+(?:\.\d+)?)/, 1]
  end

  # The bin directory of the Ruby the lock run uses: the Ruby that runs
  # this script, or nixpkgs' Ruby of the minor version the project asks
  # for when that differs.
  def lock_ruby_bindir
    @lock_ruby_bindir ||= begin
      wanted = project_ruby_version
      intrinsic_entries = (@input_views || []).flat_map do |view|
        JSON.parse(File.read(view.fetch("catalog"))).fetch("intrinsics", [])
      end
      sdk_origins = intrinsic_entries.map { |entry| entry.fetch("sdk") }.uniq
      fail!("Nix inputs require different Ruby SDKs") if sdk_origins.size > 1
      if sdk_origins.any?
        entry = intrinsic_entries.first
        fail!("Nix input Ruby #{entry.fetch('ruby')} conflicts with project Ruby #{wanted}") if wanted && wanted.split(".")[0,2] != entry.fetch("ruby").split(".")[0,2]
        fail!("Nix input Ruby SDK is for #{entry.fetch('system')}, current platform is #{Gem::Platform.local}") unless entry.fetch("system") == Gem::Platform.local.to_s
        File.join(sdk_origins.first, "bin")
      elsif !(selected = ENV.fetch("BUNDLER_PURIFIER_PROJECT_RUBY", "")).empty?
        actual = capture!(File.join(selected, "bin/ruby"), "-e", "print RUBY_VERSION")
        fail!("selected Ruby #{actual} conflicts with project Ruby #{wanted}") if wanted && wanted.split(".")[0,2] != actual.split(".")[0,2]
        File.join(selected, "bin")
      elsif wanted.nil? || wanted.split(".")[0, 2] == RUBY_VERSION.split(".")[0, 2]
        RbConfig::CONFIG["bindir"]
      else
        major, minor = wanted.split(".")
        out, status = Open3.capture2("nix-build", nixpkgs, "-A", "ruby_#{major}_#{minor}", "--no-out-link")
        fail!("the project asks for Ruby #{wanted}, and nixpkgs has no ruby_#{major}_#{minor}") unless status.success?
        File.join(out.strip, "bin")
      end
    end
  end

  # The settings of the project's .bundle/config that apply to the lock
  # run: all of them except the ones that narrow what is locked (groups)
  # or where it goes.
  LOCK_RUN_IGNORED_SETTINGS = %w[
    BUNDLE_WITHOUT BUNDLE_WITH BUNDLE_ONLY BUNDLE_PATH BUNDLE_FROZEN BUNDLE_DEPLOYMENT
    BUNDLE_CACHE_PATH BUNDLE_BIN BUNDLE_APP_CONFIG
  ].freeze

  # Bundler reads .bundle/config with its own YAML serializer, which a
  # general YAML writer's quoting can break, so the file is read and
  # written with that serializer.
  def write_lock_run_config(dir)
    require "bundler/yaml_serializer"
    config = {}
    project = File.join(root, ".bundle", "config")
    if File.file?(project)
      config = Bundler::YAMLSerializer.load(File.read(project)).reject { |k, _| LOCK_RUN_IGNORED_SETTINGS.include?(k) }
    end
    FileUtils.mkdir_p(dir)
    File.write(File.join(dir, "config"), config.empty? ? "--- {}\n" : Bundler::YAMLSerializer.dump(config))
  end

  # Runs Bundler in the project with empty gem, user and cache directories,
  # so that what it fetches is everything the project needs. Its
  # configuration is the project's .bundle/config without the settings in
  # LOCK_RUN_IGNORED_SETTINGS, so every group is locked; the user's .gemrc
  # does not apply. HOME stays, so that git reaches private git sources
  # with the user's SSH keys and credential helpers.
  def lock_env(state)
    {
      "PATH" => "#{lock_ruby_bindir}:#{ENV["PATH"]}",
      "GEMRC" => File.join(state, "gemrc"),
      "XDG_CACHE_HOME" => File.join(state, "xdg-cache"),
      "XDG_CONFIG_HOME" => File.join(state, "xdg-config"),
      "XDG_DATA_HOME" => File.join(state, "xdg-data"),
      "XDG_STATE_HOME" => File.join(state, "xdg-state"),
      "GEM_HOME" => File.join(state, "gems"),
      "BUNDLE_USER_HOME" => File.join(state, "bundle-home"),
      "BUNDLE_APP_CONFIG" => File.join(state, "bundle-config"),
      "BUNDLE_CACHE_PATH" => Pathname.new(File.join(state, "cache")).relative_path_from(Pathname.new(root)).to_s,
      "BUNDLE_CACHE_ALL" => "true",
      "BUNDLE_CACHE_ALL_PLATFORMS" => "true",
      "BUNDLE_GEMFILE" => nil,
      "BUNDLE_PATH" => nil,
      "BUNDLE_WITHOUT" => nil,
      "BUNDLE_FROZEN" => nil,
      "BUNDLE_DEPLOYMENT" => nil,
    }
  end

  def remote_url(remote)
    s = remote.to_s
    s.end_with?("/") ? s : "#{s}/"
  end

  # Runs the lock run and writes the purifier lockfile, which holds only
  # what Gemfile.lock lacks (see nix/lib/lock.nix): the hashes of gem files
  # that its CHECKSUMS section does not list, of Bundler's own gem and of
  # git checkouts; the remote of a gem in a section with several remotes;
  # mirrors; the executables of the project's gemspecs; and the Ruby the
  # lock run used. With an outside Gemfile.lock, the lock run works on it
  # in the tree (with_gemfile_lock_in_tree).
  def tools_dir
    ENV["BUNDLER_PURIFIER_TOOLS"] || File.expand_path("../tools", __dir__)
  end

  def resolve_project_inputs(refresh: false)
    return if defined?(@project_inputs) && !refresh
    previous = File.file?(lockfile_path) ? JSON.parse(File.read(lockfile_path)).fetch("projectInputs", []) : []
    references = @input_references || previous.map { |entry| entry.fetch("reference") }
    @project_inputs = []
    @input_views = []
    return if references.empty?
    request = { "references" => references, "previous" => previous, "refresh" => refresh,
                "roots" => File.join(state_dir, "inputs") }
    output, status = Open3.capture2("python3", File.join(tools_dir, "resolve_inputs.py"), stdin_data: JSON.dump(request))
    fail!("could not resolve Nix repository inputs") unless status.success?
    result = JSON.parse(output)
    @project_inputs = result.fetch("inputs")
    @input_views = result.fetch("views")
  end

  def provided_gem?(name)
    (@input_views || []).any? do |view|
      catalog = JSON.parse(File.read(view.fetch("catalog")))
      (catalog.fetch("packages") + catalog.fetch("intrinsics", [])).any? { |entry| entry.fetch("name") == name }
    end
  end

  # The selected consumer SDK reports its own identity and command ABI.
  # The host Ruby running this CLI must never stand in for that SDK.
  def native_bundler_capabilities(env = {})
    code = 'require "rubygems"; gem "bundler", ENV.fetch("BUNDLER_PURIFIER_BUNDLER_VERSION", ">= 0"); require "bundler"; require "bundler/cli"; puts [Bundler::VERSION, Bundler::CLI.instance_methods.map { |name| name.to_s }.include?("lock") && (defined?(Bundler::SourceList) || !defined?(Bundler::Definition)) ? "lock" : "install"].join("|")'
    out, status = Open3.capture2(env, File.join(lock_ruby_bindir, "ruby"), "-e", code)
    fail!("could not inspect the selected native Bundler SDK") unless status.success?
    version, command = out.strip.split("|")
    fail!("selected native Bundler returned an invalid identity") unless version && Gem::Version.correct?(version) && %w[lock install].include?(command)
    { "version" => version, "lockCommand" => command }
  end

  def locked_bundler_version(lock)
    marker = Bundler::LockfileParser.new(File.read(gemfile_lock_path)).bundler_version&.to_s
    recorded = lock["bundlerVersion"]
    if recorded && (!recorded.is_a?(String) || !Gem::Version.correct?(recorded))
      fail!("#{lock_name} has an invalid bundlerVersion; recapture with the intended native SDK using bundler-purifier lock --force")
    end
    fail!("#{lock_name} bundlerVersion conflicts with native BUNDLED WITH; recapture with the intended native SDK") if marker && recorded && marker != recorded
    marker || recorded || fail!("Gemfile.lock has no BUNDLED WITH and #{lock_name} lacks bundlerVersion; recapture with the intended native SDK using bundler-purifier lock --force")
  end

  def native_gem_install_flags
    help, status = Open3.capture2(File.join(lock_ruby_bindir, "gem"), "help", "install")
    fail!("could not inspect the selected native RubyGems install command") unless status.success?
    help.include?("--no-document") || help.include?("--[no-]document") ? ["--no-document"] : ["--no-rdoc", "--no-ri"]
  end

  def native_bundle!(env, *arguments, persist_lock: false)
    if (@input_views || []).empty?
      run!(env, "bundle", *arguments, chdir: env.fetch("BUNDLER_PURIFIER_WORKING_DIRECTORY", root))
    else
      native_env = env.merge("BUNDLER_PURIFIER_INPUT_VIEWS" => JSON.dump(@input_views),
                             "BUNDLER_PURIFIER_PERSIST_LOCK" => persist_lock ? "1" : "0")
      run!(native_env, File.join(lock_ruby_bindir, "ruby"),
           File.join(tools_dir, "native_bundle_command.rb"), *arguments, chdir: root)
    end
  end

  def lock(force:)
    with_gemfile_lock_in_tree { lock_in_tree(force: force) }
  end

  def lock_in_tree(force:)
    resolve_project_inputs
    if !force && File.file?(lockfile_path)
      current = begin
        JSON.parse(File.read(lockfile_path))
      rescue JSON::ParserError
        {}
      end
      if current["version"] == LOCK_VERSION && current["definitionHash"] == definition_hash && current.fetch("projectInputs", []) == @project_inputs
        check_complete!(current)
        puts "bundler-purifier: #{lock_name} is up to date"
        return
      end
    end

    Dir.mktmpdir("bundler-purifier-lock") do |state|
      env = lock_env(state)
      write_lock_run_config(env["BUNDLE_APP_CONFIG"])
      existing_marker = File.file?(gemfile_lock_path) && Bundler::LockfileParser.new(File.read(gemfile_lock_path)).bundler_version&.to_s
      native_sdk = existing_marker ? { "version" => existing_marker, "lockCommand" => "lock" } : native_bundler_capabilities(env).merge("observed" => true)
      env["BUNDLER_PURIFIER_BUNDLER_VERSION"] = native_sdk.fetch("version") if native_sdk["observed"]

      if !File.file?(gemfile_lock_path) || !@input_views.empty?
        puts "bundler-purifier: no Gemfile.lock; resolving with bundle lock"
        native_bundle!(env, native_sdk.fetch("lockCommand"), persist_lock: true)
      end

      locked_bundler = Bundler::LockfileParser.new(File.read(gemfile_lock_path)).bundler_version
      if native_sdk.fetch("lockCommand") == "install"
        native_bundle!(env, "cache", persist_lock: true)
      else
        cache_command = locked_bundler && locked_bundler < Gem::Version.new("2.0") ? "package" : "cache"
        native_bundle!(env, cache_command, "--all-platforms", "--no-install", persist_lock: true)
      end
      cache = File.expand_path(env["BUNDLE_CACHE_PATH"], root)
      text = File.read(gemfile_lock_path)
      parser = Bundler::LockfileParser.new(text)
      checksums = gemfile_lock_checksums(text)
      check_platforms(parser)
      absolute = external_paths(parser).select { |p| p.start_with?("/") }
      unless absolute.empty?
        fail!("Gemfile.lock names path sources by absolute path (#{absolute.join(", ")}). A Nix build runs in a sandbox " \
              "where it can create files only in its own build directory, so it cannot put a tree at an absolute path. " \
              "Give these sources as paths relative to the Gemfile.")
      end

      gem_hashes = {}
      gem_sources = {}
      mirrors = {}
      git_hashes = {}
      executables = {}

      parser.specs.each do |spec|
        next if provided_gem?(spec.name)
        case (source = spec.source)
        when Bundler::Source::Rubygems
          file = "#{spec.full_name}.gem"
          path = File.join(cache, file)
          fail!("bundle cache did not write #{file}") unless File.file?(path)
          hash = sri(path)
          key = "#{spec.name} (#{spec.full_name.delete_prefix("#{spec.name}-")})"
          if checksums.key?(key)
            fail!("#{file} does not match its sha256 in the CHECKSUMS of Gemfile.lock") unless hex_to_sri(checksums[key]) == hash
          else
            gem_hashes[file] = hash
          end
          url = gem_url(source.remotes, file, hash)
          gem_sources[file] = url.delete_suffix("gems/#{file}") if source.remotes.size > 1
          m = mirrors_for(url)
          mirrors[file] = m unless m.empty?
        when Bundler::Source::Git
          next if git_hashes.key?(source.revision)
          git = {
            "url" => https_git_url(source.uri),
            "rev" => source.revision,
            "submodules" => source.options["submodules"] ? true : false,
          }
          git_hashes[source.revision] = git_nar_hash(git)
        when Bundler::Source::Path
          dir = File.expand_path(source.path.to_s, root)
          # A path source outside the project is a tree the Nix build
          # takes as an argument (externalPaths); it builds no gem.
          next unless dir == root || dir.start_with?("#{root}/")
          gemspec = Dir.glob("#{spec.name}.gemspec", base: dir).first || Dir.glob("*.gemspec", base: dir).first
          next unless gemspec
          exes = Bundler.load_gemspec(File.join(dir, gemspec)).executables.sort
          executables[spec.name] = exes unless exes.empty?
        end
      end

      marker = parser.bundler_version&.to_s
      bundler = marker || native_sdk.fetch("version")
      fail!("selected native Bundler SDK does not match BUNDLED WITH") if native_sdk["observed"] && marker && marker != native_sdk.fetch("version")
      bundler_url = "https://rubygems.org/gems/bundler-#{bundler}.gem"
      m = mirrors_for(bundler_url)
      mirrors["bundler-#{bundler}.gem"] = m unless m.empty?

      lockfile = {
        "version" => LOCK_VERSION,
        "definitionHash" => definition_hash,
        "ruby" => capture!(File.join(lock_ruby_bindir, "ruby"), "-e", "print RUBY_VERSION"),
        "bundlerHash" => lock_bundler(bundler, env, state),
      }
      lockfile["bundlerVersion"] = bundler unless marker
      { "gemHashes" => gem_hashes, "gemSources" => gem_sources, "mirrors" => mirrors,
        "gitHashes" => git_hashes, "executables" => executables }.each do |key, value|
        lockfile[key] = value.sort.to_h unless value.empty?
      end
      lockfile["projectInputs"] = @project_inputs unless @project_inputs.empty?
      lockfile["contentHash"] = content_hash(lockfile)
      FileUtils.mkdir_p(File.dirname(lockfile_path))
      File.write(lockfile_path, JSON.pretty_generate(lockfile) + "\n")
      puts "bundler-purifier: wrote #{lockfile_path}"
    end
  end

  # The URL a Nix build fetches a git source from. The Nix sandbox has no
  # SSH keys, so a source over SSH (git@host:path or ssh://host/path) is
  # locked at the HTTPS URL of the same host and path; a private repository
  # takes a credentialed fetchgit in the builder's `fetchers`.
  def https_git_url(uri)
    case uri
    when %r{\Assh://(?:[^@/]+@)?([^/:]+)(?::\d+)?/(.+)\z} then "https://#{$1}/#{$2}"
    when %r{\A(?:[^@/]+@)?([^/:]+):(?!//)(.+)\z} then "https://#{$1}/#{$2.delete_prefix("/")}"
    else uri
    end
  end

  # The hash of a git checkout as nixpkgs' fetchgit makes it, which is what
  # a Nix build fetches and checks the locked hash against.
  def git_nar_hash(git)
    cmd = ["nix-prefetch-git", "--quiet", "--url", git["url"], "--rev", git["rev"]]
    cmd << "--fetch-submodules" if git["submodules"]
    JSON.parse(capture!(*cmd)).fetch("hash")
  end

  # The URL a gem file came from. A source with one remote serves it at
  # <remote>gems/<file>. A source with several remotes (several `source`
  # lines merged into one section of an old Gemfile.lock) may have served
  # it from any of them, so each remote is asked for the file, and the one
  # whose file has the cached file's hash is locked.
  def gem_url(remotes, file, hash)
    urls = remotes.map { |r| "#{remote_url(r)}gems/#{file}" }
    return urls.first if urls.size == 1
    urls.each do |url|
      body = begin
        Gem::RemoteFetcher.fetcher.fetch_path(url)
      rescue Gem::RemoteFetcher::FetchError
        next
      end
      return url if "sha256-#{Digest::SHA256.base64digest(body)}" == hash
    end
    fail!("none of #{urls.join(", ")} serves the #{file} that bundle cache wrote")
  end

  # The hash of the gem of the Bundler of BUNDLED WITH, which a Nix build
  # installs from the gem cache rather than fetching it.
  def lock_bundler(version, env, state)
    file = "bundler-#{version}.gem"
    fetched = File.join(state, "bundler-fetch")
    FileUtils.mkdir_p(fetched)
    path = File.join(fetched, file)
    # Fetch exact SDK bytes through the host helper, without asking an EOL
    # client to load today's complete registry index. Identity comes from
    # the observed native SDK, and the consumer still installs it natively.
    File.binwrite(path, Gem::RemoteFetcher.fetcher.fetch_path("https://rubygems.org/gems/#{file}"))
    spec = Gem::Package.new(path).spec
    fail!("downloaded Bundler gem does not match the selected native SDK") unless spec.name == "bundler" && spec.version.to_s == version
    sri(path)
  end

  # Other URLs of a gem file: the mirror that Bundler's configuration
  # (`bundle config mirror.<source> <mirror>`, from the user's global
  # configuration, the project's .bundle/config or the environment) gives
  # its source, when there is one.
  def mirrors_for(url)
    @bundler_settings ||= Bundler::Settings.new(File.join(root, ".bundle"))
    source = url[%r{\A.*/(?=gems/[^/]+\z)}]
    mirror = @bundler_settings.mirror_for(source).to_s
    mirror = "#{mirror}/" unless mirror.end_with?("/")
    mirror == source ? [] : ["#{mirror}#{url.delete_prefix(source)}"]
  end

  def check_platforms(parser)
    platforms = parser.platforms.map(&:to_s)
    return if platforms.include?("ruby")
    missing = %w[x86_64-linux aarch64-linux].reject { |p| platforms.any? { |q| q == p || q.start_with?("#{p}-") } }
    return if missing.empty?
    warn "bundler-purifier: Gemfile.lock lists no platform for #{missing.join(", ")}; a Nix build there fails. " \
         "Run: bundle lock --add-platform #{missing.join(" ")}"
  end

  def read_lock!
    fail!("no #{lockfile_path}; run bundler-purifier lock") unless File.file?(lockfile_path)
    lock = begin
      JSON.parse(File.read(lockfile_path))
    rescue JSON::ParserError => e
      fail!("#{lock_name} is not valid JSON (#{e.message.lines.first.strip}); run bundler-purifier lock --force")
    end
    fail!("#{lock_name} is not a JSON object; run bundler-purifier lock --force") unless lock.is_a?(Hash)
    fail!("#{lock_name} has lock format version #{lock["version"]}; this bundler-purifier writes version #{LOCK_VERSION}. Run bundler-purifier lock --force") unless lock["version"] == LOCK_VERSION
    fail!("#{lock_name} was changed by hand: its content does not match its contentHash. Run bundler-purifier lock --force") unless lock["contentHash"] == content_hash(lock)
    fail!("the Gemfile, Gemfile.lock or a gemspec changed since #{lock_name} was made; run bundler-purifier lock") unless lock["definitionHash"] == definition_hash
    check_complete!(lock)
    lock
  end

  # Fails unless the lock holds everything Gemfile.lock needs from it: a
  # hash for each gem file that CHECKSUMS does not list, the remote of each
  # gem in a section with several remotes, and the hashes of Bundler's own
  # gem and of each git checkout.
  def check_complete!(lock)
    resolve_project_inputs unless lock.fetch("projectInputs", []).empty?
    text = File.read(gemfile_lock_path)
    parser = Bundler::LockfileParser.new(text)
    checksums = gemfile_lock_checksums(text)
    absent = []
    parser.specs.each do |spec|
      next if provided_gem?(spec.name)
      case (source = spec.source)
      when Bundler::Source::Rubygems
        file = "#{spec.full_name}.gem"
        key = "#{spec.name} (#{spec.full_name.delete_prefix("#{spec.name}-")})"
        absent << "a hash for #{file}" unless checksums.key?(key) || lock.dig("gemHashes", file)
        absent << "a source for #{file}" if source.remotes.size > 1 && !lock.dig("gemSources", file)
      when Bundler::Source::Git
        absent << "a hash for the git checkout #{source.uri} at #{source.revision}" unless lock.dig("gitHashes", source.revision)
      end
    end
    locked_bundler_version(lock)
    absent << "a hash for Bundler's gem" unless lock["bundlerHash"]
    return if absent.empty?
    fail!("#{lock_name} lacks #{absent.first}, which Gemfile.lock needs; run bundler-purifier lock")
  end

  def lib_dir
    ENV["BUNDLER_PURIFIER_LIB"] || fail!("BUNDLER_PURIFIER_LIB is not set; run bundler-purifier through its Nix package")
  end

  # The shared nix-purifiers library as a locked flake reference.
  def shared_flake
    ENV["BUNDLER_PURIFIER_SHARED_FLAKE"] || fail!("BUNDLER_PURIFIER_SHARED_FLAKE is not set; run bundler-purifier through its Nix package")
  end

  def nixpkgs
    ENV["BUNDLER_PURIFIER_NIXPKGS"] || fail!("BUNDLER_PURIFIER_NIXPKGS is not set; run bundler-purifier through its Nix package")
  end

  # The arguments that select the builder's result for this project in
  # nix/lib/realize.nix.
  def realize_args
    ["--argstr", "root", root, "--argstr", "lockFile", lockfile_path, "--argstr", "gemfileLock", gemfile_lock_path,
     "--arg", "nixpkgs", nixpkgs, "--argstr", "purifierFlake", shared_flake, "--argstr", "integrationTools", tools_dir,
     "--argstr", "rubyExpression", ENV.fetch("BUNDLER_PURIFIER_RUBY_EXPRESSION", ""),
     "--argstr", "nativeBuildInputsExpression", ENV.fetch("BUNDLER_PURIFIER_NATIVE_BUILD_INPUTS_EXPRESSION", "[ ]")]
  end

  # The user's PATH, then the Ruby that runs this script, so that publish
  # uses the user's own gem and its credentials when there is one.
  def user_ruby_path
    "#{ENV["PATH"]}:#{RbConfig::CONFIG["bindir"]}"
  end

  # Realizes the gem cache and the dev shell of the lock, each kept alive
  # by a GC root beside the purifier lockfile, then installs the bundle
  # from that cache offline, in that shell. Bundler leaves marker files in
  # its cache, so the cache is a writable copy whose gem files stay links
  # into the store, and the project's .bundle/config names it as Bundler's
  # cache_path, so a later `bundle install` reads it too.
  def prefetch(args)
    lock = read_lock!
    bundler_version = locked_bundler_version(lock)
    unless Bundler::LockfileParser.new(File.read(gemfile_lock_path)).bundler_version
      actual = native_bundler_capabilities.fetch("version")
      fail!("selected native Bundler SDK #{actual} conflicts with recorded bundlerVersion #{bundler_version}; use the intended native SDK") unless actual == bundler_version
    end
    FileUtils.mkdir_p(state_dir)
    realize = File.join(lib_dir, "realize.nix")
    built = capture!("nix-build", realize, "-A", "gemCache", *realize_args,
                     "--out-link", File.join(state_dir, "gem-cache")).strip
    shell = File.join(state_dir, "shell")
    run!({}, "nix", "develop", "--file", realize, "devShell", *realize_args, "--profile", shell, "--command", "true",
         chdir: root)

    bundler_home = File.join(state_dir, "bundler")
    run!({}, "nix", "develop", shell, "--command", "gem", "install", "--local", *native_gem_install_flags,
         "--install-dir", bundler_home, "--bindir", File.join(bundler_home, "bin"),
         File.join(built, "bundler-#{bundler_version}.gem"), chdir: root)
    locked_env = { "GEM_HOME" => bundler_home, "GEM_PATH" => bundler_home,
                   "BUNDLER_PURIFIER_BUNDLER_VERSION" => bundler_version }
    config_command = Gem::Version.new(bundler_version) >= Gem::Version.new("2.1") ? %w[config set --local] : %w[config --local]

    cache = File.join(state_dir, "cache")
    FileUtils.rm_rf(cache)
    FileUtils.mkdir_p(cache)
    Dir.children(built).each do |entry|
      source = File.join(built, entry)
      dest = File.join(cache, entry)
      if File.symlink?(source)
        File.symlink(File.readlink(source), dest)
      else
        FileUtils.cp_r(source, dest)
        FileUtils.chmod_R("u+w", dest)
      end
    end
    run!({}, "nix", "develop", shell, "--command", "bundle", *config_command, "cache_path", Pathname.new(cache).relative_path_from(Pathname.new(root)).to_s, chdir: root)
    # A fresh project gets its own gems, rather than sharing the Ruby's
    # system or user gem directory. Explicit Bundler paths (including
    # path.system) remain the user's choice.
    settings = Bundler::Settings.new(File.join(root, ".bundle"))
    unless settings[:path] || settings["path.system"]
      run!({}, "nix", "develop", shell, "--command", "bundle", *config_command, "path", "vendor/bundle", chdir: root)
    end
    with_gemfile_lock_in_tree do
      if (@input_views || []).empty?
        run!(locked_env, "nix", "develop", shell, "--command", "bundle", "install", "--local", *args, chdir: root)
      else
        env = locked_env.merge("BUNDLER_PURIFIER_INPUT_VIEWS" => JSON.dump(@input_views))
        run!(env, "nix", "develop", shell, "--command", "ruby",
             File.join(tools_dir, "native_bundle_command.rb"), "install", "--local", *args, chdir: root)
      end
    end
    environment = capture!("nix-instantiate", realize, "-A", "environment", *realize_args,
                           "--eval", "--strict", "--json", "--read-write-mode")
    File.write(File.join(state_dir, "environment.json"), environment)
    puts "bundler-purifier: prefetched"
  end

  # The shell definition comes from this package, not a generated project
  # flake. Evaluate it against the project's current lockfiles; the local
  # profile only keeps the resulting environment alive through GC.
  def shell(args)
    args = args.drop(1) if args.first == "--"
    unless File.file?(lockfile_path)
      warn "bundler-purifier: no lockfile; using the ordinary, impure environment"
      command = args.empty? ? [ENV.fetch("SHELL", "bash")] : args
      exec(*command, chdir: root)
    end
    read_lock!
    FileUtils.mkdir_p(state_dir)
    command = ["nix", "develop", "--file", File.join(lib_dir, "realize.nix"),
               "devShell", *realize_args, "--profile", File.join(state_dir, "shell")]
    command += ["--command", *args] unless args.empty?
    exec(*command, chdir: root)
  end

  # Re-resolves Gemfile.lock with Bundler's own `bundle update`, for every
  # gem or the named ones, in the environment of the lock run, then relocks
  # the purifier lockfile against the result.
  def update(gems)
    resolve_project_inputs(refresh: true)
    with_gemfile_lock_in_tree do
      Dir.mktmpdir("bundler-purifier-update") do |state|
        env = lock_env(state)
        write_lock_run_config(env["BUNDLE_APP_CONFIG"])
        native_bundle!(env, "update", *gems, persist_lock: true)
      end
      lock(force: true)
    end
  end

  # Pushes each gem file of the `release` that Nix built with `gem push`.
  def publish(args)
    lock = read_lock!
    composed = !lock.fetch("projectInputs", []).empty?
    attribute = composed ? "release.projections.rubygems" : "release"
    out = capture!("nix-build", File.join(lib_dir, "realize.nix"), "-A", attribute, *realize_args, "--no-out-link").strip
    gems = Dir.glob(File.join(out, composed ? "gems/*.gem" : "*.gem"))
    fail!("the release holds no gem file") if gems.empty?
    host_index = args.index("--host")
    host = host_index ? args.fetch(host_index + 1) : (args.find { |arg| arg.start_with?("--host=") }&.delete_prefix("--host=") || ENV["RUBYGEMS_HOST"] || Gem.host)
    gems.each do |gem|
      if composed
        fetcher = Gem::RemoteFetcher.fetcher
        url = "#{host.delete_suffix('/')}/gems/#{File.basename(gem)}"
        response = fetcher.request(Gem::Uri.new(url), Gem::Net::HTTP::Get) do |request|
          fetcher.headers.each { |key, value| request.add_field(key, value) }
        end
        unless response.is_a?(Gem::Net::HTTPNotFound)
          published = response.is_a?(Gem::Net::HTTPOK) ? response.body : fetcher.fetch_path(url)
          fail!("published gem has different bytes: #{File.basename(gem)}") unless Digest::SHA512.digest(published) == Digest::SHA512.file(gem).digest
          next
        end
      end
      run!({ "PATH" => user_ruby_path }, "gem", "push", gem, *args, chdir: root)
    end
  end

  USAGE = <<~USAGE
    usage: bundler-purifier [--lockfile PATH] [--tool-lockfile PATH] COMMAND
      lock [--force] [--input FLAKE#PACKAGE]   record what Gemfile.lock cannot, when the Gemfile,
                       Gemfile.lock or a gemspec changed (or always)
      update [GEM...]  re-resolve every gem, or the named ones, with
                       bundle update, then lock
      prefetch [ARGS]  realize the locked gems and the dev shell, and
                       install the bundle offline (ARGS go to bundle install)
      shell [COMMAND...] enter the project environment, or run COMMAND in it
      publish [ARGS]   push the gems that Nix built (ARGS go to gem push)
  USAGE

  # Removes `name PATH` or `name=PATH` from argv and returns the path.
  def take_option(argv, name)
    if (i = argv.index(name))
      argv.delete_at(i)
      argv.delete_at(i) || fail!("#{name} needs a path")
    elsif (i = argv.index { |a| a.start_with?("#{name}=") })
      argv.delete_at(i).delete_prefix("#{name}=")
    end
  end

  def main(argv)
    argv = argv.dup
    @lockfile_option = take_option(argv, "--lockfile")
    @tool_lockfile_option = take_option(argv, "--tool-lockfile")
    references = []
    while (reference = take_option(argv, "--input"))
      references << reference
    end
    @input_references = references unless references.empty?
    command = argv.shift
    case command
    when "lock" then lock(force: argv.delete("--force") ? true : false)
    when "update" then update(argv)
    when "prefetch" then prefetch(argv)
    when "shell" then shell(argv)
    when "publish" then publish(argv)
    else
      warn USAGE
      exit(command.nil? ? 1 : 2)
    end
  end
end

# The unit tests load this file without running a command.
BundlerPurifier.main(ARGV) if $PROGRAM_NAME == __FILE__
